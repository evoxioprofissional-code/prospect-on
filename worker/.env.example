# Worker de disparo — variáveis (no Railway, adicione em Variables)

# Supabase (mesmo projeto do app)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=          # chave SECRETA (sb_secret_...). Nunca no cliente.

# Evolution API (o mesmo que o app usa)
EVOLUTION_API_URL=             # ex.: https://evolution-xxxx.up.railway.app
EVOLUTION_API_KEY=             # a apikey global do Evolution (AUTHENTICATION_API_KEY)

# OPCIONAL — restringe o worker a UM time (para testar). Vazio = todas as contas.
# WORKER_OWNER_ID=

# Intervalos (ms)
POLL_MS=15000                  # espera quando um número está desconectado
SCAN_MS=10000                  # varredura por novas contas/campanhas
