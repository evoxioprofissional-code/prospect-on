# Worker de disparo — variáveis (no Railway, adicione em Variables)

# Supabase (mesmo projeto do app)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=          # chave SECRETA (sb_secret_...). Nunca no cliente.

# Evolution API (o mesmo que você já usa)
EVOLUTION_API_URL=             # ex.: https://evolution-xxxx.up.railway.app
EVOLUTION_API_KEY=             # a apikey global do Evolution

# auth uid do DONO da conta (dono do time). Liga a instância e a fila a este número.
# Supabase > Authentication > Users > (o dono) > User UID.
WORKER_OWNER_ID=

# Intervalo (ms) de checagem da fila quando não há nada para enviar.
POLL_MS=15000
