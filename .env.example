# Supabase — no cliente use SÓ a chave pública.
# Projetos novos usam "sb_publishable_..."; projetos antigos usam a "anon" (eyJ...).
# NUNCA use aqui a service_role / sb_secret (essas são secretas, só no servidor).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Opcional — só para a fonte "Google Places" na descoberta de leads.
# Crie em https://console.cloud.google.com (ative "Places API (New)" + billing).
# Fica só no servidor; NÃO use prefixo NEXT_PUBLIC.
GOOGLE_PLACES_API_KEY=

# Opcional — só para o botão "Gerar com IA" na Central de Disparo.
# Crie em https://console.anthropic.com. Fica só no servidor.
ANTHROPIC_API_KEY=

# Chave SECRETA do Supabase (service_role / sb_secret) — só servidor.
# Usada para medir buscas e mudar planos ignorando o RLS. NUNCA no cliente.
# Sem ela, a cota não é aplicada (modo aberto).
SUPABASE_SERVICE_KEY=

# Mercado Pago — Access Token (server-only). Assinaturas recorrentes.
# Comece com o token de TESTE; troque pelo de PRODUÇÃO quando for ao ar.
MERCADOPAGO_ACCESS_TOKEN=

# URL pública do site (usada no retorno do checkout). Opcional.
NEXT_PUBLIC_SITE_URL=https://www.prospecton.com.br
